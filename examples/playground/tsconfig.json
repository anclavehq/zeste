{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"types": ["vite/client", "node"],
		"paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "scripts", "vite.config.ts"]
}

{
  "name": "zeste-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter '!e2e' test",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "release": "pnpm build && pnpm -r --filter \"./packages/*\" publish --access public"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
